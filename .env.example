# ─── Database (Neon · aws-ap-southeast-1 · Singapore) ───────────────────────
#
# CREDENTIAL SEPARATION — the most important rule in this file.
#
#   Variable               Role        Endpoint   Lives in
#   ---------------------  ----------  ---------  ------------------------------
#   DATABASE_URL           app_user    pooled     Vercel (all envs) + local
#   DATABASE_URL_MIGRATE   app_owner   direct     GitHub Actions + local ONLY
#   DATABASE_URL_TEST      app_user    pooled     GitHub Actions + local ONLY
#   DATABASE_URL_BOOTSTRAP app_admin   direct     operator machine ONLY (see below)
#
# DATABASE_URL_MIGRATE MUST NEVER BE ADDED TO VERCEL. app_owner owns the schema,
# and an owner connection is exactly what RLS does not constrain. src/env.ts
# refuses to boot in production if it is present.

# Runtime connection. Role: app_user. MUST be the POOLED endpoint (-pooler in host).
# app_user has no BYPASSRLS and owns no tables — this is what makes RLS real.
DATABASE_URL=

# Migrations only. Role: app_owner. MUST be the DIRECT endpoint. NOT IN VERCEL.
DATABASE_URL_MIGRATE=

# Integration tests. Role: app_user, staging branch. NOT IN VERCEL.
DATABASE_URL_TEST=

# ─── Application ────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Cloudflare R2 (private buckets; see Task 8) ────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_HR=pravshi-hr
R2_BUCKET_CORPORATE=pravshi-corporate
R2_BUCKET_PROJECTS=pravshi-projects

# ─── Health checks ──────────────────────────────────────────────────────────
# Shared secret for GET /health/db, sent as the x-pravshi-health-token header.
# /health is public and database-free — point uptime monitors THERE.
# /health/db wakes suspended Neon compute, so it is gated: unset means nobody.
# Generate with: openssl rand -hex 32
HEALTH_CHECK_TOKEN=

# ─── Observability ──────────────────────────────────────────────────────────
# Server and edge. Read through src/env.ts. Optional: unset means Sentry is disabled.
SENTRY_DSN=
# Browser only. Inlined at build time by textual substitution, which is why
# instrumentation-client.ts reads it as a literal rather than through src/env.ts.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload during build. Not in use; part of the deferred production setup.
SENTRY_AUTH_TOKEN=

# ─── Phase 1 (documented now, unused in Phase 0) ────────────────────────────
# Signs Better Auth session cookies. Required at runtime; at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# RESEND_API_KEY=
# Invitation emails, via Resend. Both optional: when either is blank, no invitation
# email is sent and the create-invitation endpoint returns the token to the admin
# instead, so the link can be shared another way. EMAIL_FROM must be an address on a
# domain verified in Resend.
# EMAIL_FROM=Pravshi OS <invites@example.com>

# Phase 6 job email handler. Both optional: when either is unset, email jobs
# dead-letter with EMAIL_PROVIDER_UNCONFIGURED (non-retryable) instead of sending.
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_API_KEY=<redacted>
# Phase 6 webhook signing secrets, one per signatureSecretRef (uppercased,
# non-alphanumeric → _). Optional: a webhook job whose ref is unset fails
# non-retryable rather than sending unsigned.
# WEBHOOK_SIGNING_SECRET_ACME=<redacted>

# ─── Phase 6 worker (pnpm worker) ───────────────────────────────────────────
# Scheduler tick interval for the worker process, in milliseconds. Each tick
# fires due schedules into the job queue (serialized across worker instances
# by a Postgres advisory lock). Default 60000.
SCHEDULER_TICK_MS=60000

# ─── Phase 9 AI Foundation ──────────────────────────────────────────────────
# All six optional: with none of them set, AI features run on the deterministic
# mock provider and the app boots and behaves exactly as before Phase 9.
# Provider selector: unset or mock (default, deterministic, zero network) or
# openai-compatible (alias openai) for a real provider.
# AI_PROVIDER=mock
# Model id for the real adapter. Required only when a real provider is selected.
# AI_MODEL=
# Server-side provider key. NEVER prefix with NEXT_PUBLIC_; never logged.
# AI_API_KEY=<redacted>
# Optional OpenAI-compatible endpoint override (default https://api.openai.com/v1).
# AI_BASE_URL=
# Optional overall AI request deadline in milliseconds (default 30000).
# AI_TIMEOUT_MS=
# Optional output token cap (default 800, clamped 100-4000).
# AI_MAX_OUTPUT_TOKENS=

# ─── First-run bootstrap — OPERATOR MACHINE ONLY ────────────────────────────
# Read once per database by scripts/bootstrap/run.mjs, never by the application.
# NEVER add any of these to Vercel or GitHub Actions: src/env.ts refuses to boot in
# production with DATABASE_URL_BOOTSTRAP present, and CI fails if a workflow names it.
# Read scripts/bootstrap/README.md before running anything — bootstrap cannot be undone.
#
# Role: app_admin. MUST be the DIRECT endpoint (no -pooler in the host).
DATABASE_URL_BOOTSTRAP=
BOOTSTRAP_ORG_NAME=
# Lower-case letters, digits and inner hyphens.
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_OWNER_NAME=
# Becomes the owner's login. No email address is ever compiled into the application.
BOOTSTRAP_OWNER_EMAIL=
#
# NOTE: There is deliberately no keep-alive, heartbeat or min-compute setting.
# Neon scale-to-zero is a locked decision. See the spec's LOCKED DECISIONS table.
