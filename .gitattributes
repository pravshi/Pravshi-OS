# core.autocrlf=true checks files out as CRLF on Windows, but .prettierrc pins
# endOfLine: "lf" — so `pnpm format:check` could never pass locally while passing
# in CI on Linux. Normalise to LF in the repo AND in the working tree so the
# quality gates behave identically on every machine.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.ico binary
*.svg text eol=lf
