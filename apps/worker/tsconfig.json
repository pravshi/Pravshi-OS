{
  "extends": "../../packages/shared-config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/worker/*": ["./src/*"],
      "@/lib/db/*": ["../../packages/database/src/*"],
      "@/lib/observability/*": ["../../packages/observability/src/*"],
      "@/lib/audit/*": ["../../packages/security/src/audit/*"],
      "@/lib/auth/*": ["../../packages/security/src/auth/*"],
      "@/lib/authz/*": ["../../packages/security/src/authz/*"],
      "@/lib/identity/*": ["../../packages/security/src/identity/*"],
      "@/lib/platform/*": ["../../packages/platform-core/src/*"],
      "@pravshi/database": ["../../packages/database/src/index.ts"],
      "@pravshi/database/*": ["../../packages/database/src/*"],
      "@pravshi/observability": ["../../packages/observability/src/index.ts"],
      "@pravshi/observability/*": ["../../packages/observability/src/*"],
      "@pravshi/security": ["../../packages/security/src/index.ts"],
      "@pravshi/security/*": ["../../packages/security/src/*"],
      "@pravshi/platform-core": ["../../packages/platform-core/src/index.ts"],
      "@pravshi/platform-core/*": ["../../packages/platform-core/src/*"],
      "@/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
