{
  "extends": "../shared-config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/worker/*": ["../../apps/worker/src/*"],
      "@/lib/db/*": ["../database/src/*"],
      "@/lib/observability/*": ["../observability/src/*"],
      "@/lib/audit/*": ["../security/src/audit/*"],
      "@/lib/auth/*": ["../security/src/auth/*"],
      "@/lib/authz/*": ["../security/src/authz/*"],
      "@/lib/identity/*": ["../security/src/identity/*"],
      "@/lib/platform/*": ["../platform-core/src/*"],
      "@/lib/jobs/*": ["./src/jobs/*"],
      "@/lib/notifications/*": ["./src/notifications/*"],
      "@/lib/events": ["./src/events/index.ts"],
      "@/lib/events/*": ["./src/events/*"],
      "@pravshi/database": ["../database/src/index.ts"],
      "@pravshi/database/*": ["../database/src/*"],
      "@pravshi/observability": ["../observability/src/index.ts"],
      "@pravshi/observability/*": ["../observability/src/*"],
      "@pravshi/security": ["../security/src/index.ts"],
      "@pravshi/security/*": ["../security/src/*"],
      "@pravshi/platform-core": ["../platform-core/src/index.ts"],
      "@pravshi/platform-core/*": ["../platform-core/src/*"],
      "@pravshi/shared-services": ["./src/index.ts"],
      "@pravshi/shared-services/*": ["./src/*"],
      "@/*": ["../../apps/web/src/*", "../../src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
