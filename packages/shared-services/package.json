{
  "name": "@pravshi/shared-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./jobs/*": {
      "types": "./src/jobs/*.ts",
      "default": "./src/jobs/*.ts"
    },
    "./notifications/*": {
      "types": "./src/notifications/*.ts",
      "default": "./src/notifications/*.ts"
    },
    "./events/*": {
      "types": "./src/events/*.ts",
      "default": "./src/events/*.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "default": "./src/events/index.ts"
    }
  },
  "dependencies": {
    "@pravshi/database": "workspace:*",
    "@pravshi/observability": "workspace:*",
    "@pravshi/security": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.6.6"
  }
}
