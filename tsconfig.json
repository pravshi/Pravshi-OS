{
  "extends": "./packages/shared-config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/worker/*": ["./apps/worker/src/*"],
      "@/lib/db/*": ["./packages/database/src/*"],
      "@/lib/observability/*": ["./packages/observability/src/*"],
      "@/lib/audit/*": ["./packages/security/src/audit/*"],
      "@/lib/auth/*": ["./packages/security/src/auth/*"],
      "@/lib/authz/*": ["./packages/security/src/authz/*"],
      "@/lib/identity/*": ["./packages/security/src/identity/*"],
      "@/lib/platform/*": ["./packages/platform-core/src/*"],
      "@/lib/jobs/*": ["./packages/shared-services/src/jobs/*"],
      "@/lib/notifications/*": ["./packages/shared-services/src/notifications/*"],
      "@/lib/events": ["./packages/shared-services/src/events/index.ts"],
      "@/lib/events/*": ["./packages/shared-services/src/events/*"],
      "@/lib/crm/*": ["./packages/crm-core/src/*"],
      "@/lib/work/*": ["./packages/work/src/*"],
      "@/lib/integrations/*": ["./packages/integrations/src/*"],
      "@/lib/workflows/*": ["./packages/automation/src/*"],
      "@/lib/import/*": ["./packages/imports/src/*"],
      "@/lib/search/*": ["./packages/search/src/*"],
      "@/lib/analytics/*": ["./packages/analytics/src/*"],
      "@pravshi/database": ["./packages/database/src/index.ts"],
      "@pravshi/database/*": ["./packages/database/src/*"],
      "@pravshi/observability": ["./packages/observability/src/index.ts"],
      "@pravshi/observability/*": ["./packages/observability/src/*"],
      "@pravshi/security": ["./packages/security/src/index.ts"],
      "@pravshi/security/*": ["./packages/security/src/*"],
      "@pravshi/platform-core": ["./packages/platform-core/src/index.ts"],
      "@pravshi/platform-core/*": ["./packages/platform-core/src/*"],
      "@pravshi/shared-services": ["./packages/shared-services/src/index.ts"],
      "@pravshi/shared-services/*": ["./packages/shared-services/src/*"],
      "@pravshi/contracts": ["./packages/contracts/src/index.ts"],
      "@pravshi/contracts/*": ["./packages/contracts/src/*"],
      "@pravshi/crm-core": ["./packages/crm-core/src/index.ts"],
      "@pravshi/crm-core/*": ["./packages/crm-core/src/*"],
      "@pravshi/work": ["./packages/work/src/index.ts"],
      "@pravshi/work/*": ["./packages/work/src/*"],
      "@pravshi/integrations": ["./packages/integrations/src/index.ts"],
      "@pravshi/integrations/*": ["./packages/integrations/src/*"],
      "@pravshi/automation": ["./packages/automation/src/index.ts"],
      "@pravshi/automation/*": ["./packages/automation/src/*"],
      "@pravshi/imports": ["./packages/imports/src/index.ts"],
      "@pravshi/imports/*": ["./packages/imports/src/*"],
      "@pravshi/search": ["./packages/search/src/index.ts"],
      "@pravshi/search/*": ["./packages/search/src/*"],
      "@pravshi/analytics": ["./packages/analytics/src/index.ts"],
      "@pravshi/analytics/*": ["./packages/analytics/src/*"],
      "@/*": ["./apps/web/src/*", "./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "apps/web/.next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
